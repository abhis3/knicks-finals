rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Roster and matches are publicly readable, but writeable only by authorized users
    match /players/{playerId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    match /series/{eraId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /matches/{matchId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}