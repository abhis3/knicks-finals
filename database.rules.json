{
  "rules": {
    ".read": false,
    ".write": false,
    "chats": {
      "$era": {
        ".read": true,
        "$chatId": {
          ".write": "request.auth != null",
          ".validate": "newData.hasChildren(['user', 'text', 'timestamp']) && newData.child('text').val().length < 150"
        }
      }
    },
    "ticker": {
      "$era": {
        ".read": true,
        ".write": "request.auth != null && request.auth.token.admin == true"
      }
    }
  }
}